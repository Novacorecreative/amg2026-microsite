# ---------- Event ----------
EVENT_NAME=AMG 2026
CLIENT_NAME=Grindwell Norton
EVENT_CITY=Goa
EVENT_VENUE=Venue to be announced
EVENT_VENUE_MAP_URL=
EVENT_START_DATE=2026-12-03
EVENT_END_DATE=2026-12-05
HELPDESK_PHONE=
HELPDESK_EMAIL=

# ---------- Server ----------
PORT=3000
# Public address of the microsite. Used in every WhatsApp/email link, so set it to your real domain.
BASE_URL=http://localhost:3000
ADMIN_PASSWORD=change-me
MAX_UPLOAD_MB=250
DEFAULT_COUNTRY_CODE=91

# ---------- WhatsApp ----------
# meta   = WhatsApp Cloud API (Meta Business). Needs an approved message template.
# twilio = Twilio WhatsApp sender.
# Leave empty to run in dry-run mode (messages are logged, not sent).
WHATSAPP_PROVIDER=

# Meta Cloud API
WA_META_TOKEN=
WA_META_PHONE_NUMBER_ID=
WA_META_API_VERSION=v21.0
# Template body must have 3 variables (and can't end with one):
#   Hi {{1}}, {{2}} on the AMG 2026 microsite. Open it here: {{3}} See you in Goa!
WA_TEMPLATE_NAME=amg_update
WA_TEMPLATE_LANG=en

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_CONTENT_SID=

# ---------- Email (any SMTP: Gmail Workspace, Office 365, Amazon SES, Brevo, SendGrid...) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AMG 2026 <events@example.com>"
